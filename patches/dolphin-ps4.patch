+
+// Video thread time per category since the last call (VideoCommon/PS4Profile.h), as
+// milliseconds per second of real time, with calls per second.
+static void LogProfile()
+{
+  static const char* const names[PS4_PROF_CATEGORY_COUNT] = {
+      "flush", "vtx-upload", "uniforms", "draw", "pipeline", "tex-cache",
+      "tex-upload", "compile", "link", "efb-copy", "efb-peek", "present",
+      "gpu-fifo", "cpu-wait", "tlbie", "pagetable"};
+  static unsigned long long s_ticks[PS4_PROF_CATEGORY_COUNT], s_count[PS4_PROF_CATEGORY_COUNT];
+  static unsigned long long s_tsc = 0;
+  static auto s_time = std::chrono::steady_clock::now();
+
+  const unsigned long long tsc = __rdtsc();
+  const auto time = std::chrono::steady_clock::now();
+  const double seconds = std::chrono::duration<double>(time - s_time).count();
+  if (s_tsc != 0 && seconds > 0.1)
+  {
+    const double ticks_per_ms = static_cast<double>(tsc - s_tsc) / (seconds * 1000.0);
+    char line[512];
+    int len = snprintf(line, sizeof(line), "prof (ms/s, calls/s):");
+    for (int i = 0; i < PS4_PROF_CATEGORY_COUNT; i++)
+    {
+      const unsigned long long ticks = ps4_prof_ticks[i], count = ps4_prof_count[i];
+      len += snprintf(line + len, sizeof(line) - len, " %s %.0f/%.0f", names[i],
+                      static_cast<double>(ticks - s_ticks[i]) / ticks_per_ms / seconds,
+                      static_cast<double>(count - s_count[i]) / seconds);
+      s_ticks[i] = ticks;
+      s_count[i] = count;
+    }
+    Platform::BootTrace(line);
+  }
+  else
+  {
+    for (int i = 0; i < PS4_PROF_CATEGORY_COUNT; i++)
+    {
+      s_ticks[i] = ps4_prof_ticks[i];
+      s_count[i] = ps4_prof_count[i];
+    }
+  }
+  s_tsc = tsc;
+  s_time = time;
+}
+
+void PlatformPS4::MainLoop()
+{
+  BootTrace("main loop");
+  int frame = 0;
+  const auto start = std::chrono::steady_clock::now();
+  while (m_running.IsSet())
+  {
+    UpdateRunningFlag();
+    Core::HostDispatchJobs(Core::System::GetInstance());
+    std::this_thread::sleep_for(std::chrono::milliseconds(16));
+    // Keeps the FPS average fresh for the on-screen counter (VideoCommon/Present.cpp).
+    if (frame % 30 == 29)
+      Core::System::GetInstance().GetPerfMetrics().UpdateStats();
+    // Monitor for the port: emulation speed, and flexible memory (what Piglet allocates from).
+    if (++frame % 120 == 0)
+    {
+      size_t flexible = 0;
+      using AvailableFlexibleFn = int32_t (*)(size_t*);
+      reinterpret_cast<AvailableFlexibleFn>(&sceKernelAvailableFlexibleMemorySize)(&flexible);
+      auto& perf = Core::System::GetInstance().GetPerfMetrics();
+      perf.UpdateStats();
+      const auto seconds = std::chrono::duration_cast<std::chrono::seconds>(
+                               std::chrono::steady_clock::now() - start)
+                               .count();
+      char line[320];
+      // speed: emulated time per real time; max speed: what the CPU thread could reach if it
+      // never waited (below 100% means the emulated CPU itself is the bottleneck).
+      snprintf(line, sizeof(line),
+               "monitor: %lld s, speed %.0f%% (max %.0f%%), %.1f FPS, %.1f VPS, %zu MiB flexible "
+               "free, CPU core %d, %llu fastmem faults, GL shaders %d programs %d textures %d",
+               static_cast<long long>(seconds), perf.GetSpeed() * 100.0,
+               perf.GetMaxSpeed() * 100.0, perf.GetFPS(), perf.GetVPS(),
+               flexible / (1024 * 1024), static_cast<int>(Config::Get(Config::MAIN_CPU_CORE)),
+               ps4_fault_count, ps4_gl_shaders, ps4_gl_programs, ps4_gl_textures);
+      BootTrace(line);
+      LogProfile();
+    }
+    // Port diagnostics: a screenshot every ~10 s (User/ScreenShots) shows what Dolphin renders,
+    // independently of what reaches the TV.
+    static const bool s_screenshots = GetPS4Option("screenshots", "off") == "on";
+    if (s_screenshots && frame % 600 == 0 &&
+        Core::GetState(Core::System::GetInstance()) == Core::State::Running)
+    {
+      Core::SaveScreenShot(fmt::format("diag_{:03d}", frame / 60));
+      BootTrace("screenshot requested");
+    }
+  }
+}
