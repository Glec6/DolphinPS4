+// Port diagnostics: what the draw reads its vertices from, as Piglet sees it.
+static void PS4LogVertexInput(int draw, u32 base_index, u32 num_indices)
+{
+  const auto* vm = static_cast<const OGL::VertexManager*>(g_vertex_manager.get());
+  GLint vao = 0, element = 0, array = 0, program = 0;
+  glGetIntegerv(GL_VERTEX_ARRAY_BINDING, &vao);
+  glGetIntegerv(GL_ELEMENT_ARRAY_BUFFER_BINDING, &element);
+  glGetIntegerv(GL_ARRAY_BUFFER_BINDING, &array);
+  glGetIntegerv(GL_CURRENT_PROGRAM, &program);
+
+  char line[400];
+  int len = snprintf(line, sizeof(line),
+                     "draw #%d: vao %d, element buffer %d (stream %u), array buffer %d (stream %u),"
+                     " attribs rawpos %d posmtx %d rawnormal %d rawcolor0 %d rawtex0 %d",
+                     draw, vao, element, vm->GetIndexBufferHandle(), array,
+                     vm->GetVertexBufferHandle(), glGetAttribLocation(program, "rawpos"),
+                     glGetAttribLocation(program, "posmtx"),
+                     glGetAttribLocation(program, "rawnormal"),
+                     glGetAttribLocation(program, "rawcolor0"),
+                     glGetAttribLocation(program, "rawtex0"));
+  ps4_boot_trace(line);
+
+  len = snprintf(line, sizeof(line), "draw #%d: enabled attribs:", draw);
+  for (GLuint i = 0; i < 16 && len < 340; i++)
+  {
+    GLint enabled = 0, size = 0, type = 0, normalized = 0, integer = 0, stride = 0, buffer = 0;
+    glGetVertexAttribiv(i, GL_VERTEX_ATTRIB_ARRAY_ENABLED, &enabled);
+    if (!enabled)
+      continue;
+    glGetVertexAttribiv(i, GL_VERTEX_ATTRIB_ARRAY_SIZE, &size);
+    glGetVertexAttribiv(i, GL_VERTEX_ATTRIB_ARRAY_TYPE, &type);
+    glGetVertexAttribiv(i, GL_VERTEX_ATTRIB_ARRAY_NORMALIZED, &normalized);
+    glGetVertexAttribiv(i, GL_VERTEX_ATTRIB_ARRAY_INTEGER, &integer);
+    glGetVertexAttribiv(i, GL_VERTEX_ATTRIB_ARRAY_STRIDE, &stride);
+    glGetVertexAttribiv(i, GL_VERTEX_ATTRIB_ARRAY_BUFFER_BINDING, &buffer);
+    void* pointer = nullptr;
+    glGetVertexAttribPointerv(i, GL_VERTEX_ATTRIB_ARRAY_POINTER, &pointer);
+    len += snprintf(line + len, sizeof(line) - len, " [%u: %dx0x%x%s%s stride %d +%zu buf %d]",
+                    i, size, type, normalized ? " norm" : "", integer ? " int" : "", stride,
+                    reinterpret_cast<size_t>(pointer), buffer);
+  }
+  ps4_boot_trace(line);
+
+  // What the GPU-side buffers actually hold.
+  if (element)
+  {
+    const u32 count = std::min(num_indices, 6u);
+    const auto* indices = static_cast<const u16*>(glMapBufferRange(
+        GL_ELEMENT_ARRAY_BUFFER, base_index * sizeof(u16), count * sizeof(u16), GL_MAP_READ_BIT));
+    len = snprintf(line, sizeof(line), "draw #%d: indices from %u:", draw, base_index);
+    for (u32 i = 0; indices && i < count; i++)
+      len += snprintf(line + len, sizeof(line) - len, " %u", indices[i]);
+    if (indices)
+      glUnmapBuffer(GL_ELEMENT_ARRAY_BUFFER);
+    else
+      len += snprintf(line + len, sizeof(line) - len, " (map failed, GL error 0x%x)", glGetError());
+    ps4_boot_trace(line);
+  }
+  if (array)
+  {
+    const auto* words = static_cast<const u32*>(
+        glMapBufferRange(GL_ARRAY_BUFFER, 0, 12 * sizeof(u32), GL_MAP_READ_BIT));
+    len = snprintf(line, sizeof(line), "draw #%d: vertex bytes:", draw);
+    for (u32 i = 0; words && i < 12; i++)
+    {
+      float f;
+      std::memcpy(&f, &words[i], sizeof(f));
+      len += snprintf(line + len, sizeof(line) - len, " %08x(%g)", words[i], f);
+    }
+    if (words)
+      glUnmapBuffer(GL_ARRAY_BUFFER);
+    else
+      len += snprintf(line + len, sizeof(line) - len, " (map failed, GL error 0x%x)", glGetError());
+    ps4_boot_trace(line);
+  }
+}
