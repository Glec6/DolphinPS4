diff --git a/Source/Core/AudioCommon/PS4AudioStream.cpp b/Source/Core/AudioCommon/PS4AudioStream.cpp
new file mode 100644
index 0000000..078015a
--- /dev/null
+++ b/Source/Core/AudioCommon/PS4AudioStream.cpp
@@ -0,0 +1,77 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "AudioCommon/PS4AudioStream.h"
+
+#include <orbis/AudioOut.h>
+
+#include "Common/Logging/Log.h"
+#include "Common/Thread.h"
+
+namespace
+{
+// Any user can hear the main port; the system user avoids depending on who is signed in.
+constexpr OrbisUserServiceUserId SYSTEM_USER = 0xFF;
+constexpr int32_t VOLUME_MAX = 32768;  // SCE_AUDIO_VOLUME_0DB
+constexpr int32_t VOLUME_FLAG_LR = 0x3;  // front left + front right
+}  // namespace
+
+PS4AudioStream::~PS4AudioStream()
+{
+  SetRunning(false);
+  if (m_handle >= 0)
+    sceAudioOutClose(m_handle);
+}
+
+bool PS4AudioStream::Init()
+{
+  const int32_t init = sceAudioOutInit();
+  // Already initialized (by another part of the app) is fine.
+  if (init != 0 && init != static_cast<int32_t>(0x8026000E))
+    WARN_LOG_FMT(AUDIO, "sceAudioOutInit: {:#x}", static_cast<u32>(init));
+
+  m_handle = sceAudioOutOpen(SYSTEM_USER, ORBIS_AUDIO_OUT_PORT_TYPE_MAIN, 0, FRAMES_PER_BUFFER,
+                             m_mixer->GetSampleRate(), ORBIS_AUDIO_OUT_PARAM_FORMAT_S16_STEREO);
+  if (m_handle < 0)
+  {
+    ERROR_LOG_FMT(AUDIO, "sceAudioOutOpen failed: {:#x}", static_cast<u32>(m_handle));
+    return false;
+  }
+  return true;
+}
+
+bool PS4AudioStream::SetRunning(bool running)
+{
+  if (running == m_running)
+    return true;
+  m_running = running;
+  if (running)
+    m_thread = std::thread(&PS4AudioStream::OutputLoop, this);
+  else if (m_thread.joinable())
+    m_thread.join();
+  return true;
+}
+
+void PS4AudioStream::SetVolume(int volume)
+{
+  if (m_handle < 0)
+    return;
+  int32_t levels[2] = {VOLUME_MAX * volume / 100, VOLUME_MAX * volume / 100};
+  sceAudioOutSetVolume(m_handle, VOLUME_FLAG_LR, levels);
+}
+
+void PS4AudioStream::OutputLoop()
+{
+  Common::SetCurrentThreadName("Audio thread - PS4");
+  size_t current = 0;
+  while (m_running)
+  {
+    auto& buffer = m_buffers[current];
+    m_mixer->Mix(buffer.data(), FRAMES_PER_BUFFER);
+    // Blocks until the previous buffer has been handed to the hardware, which paces this loop.
+    sceAudioOutOutput(m_handle, buffer.data());
+    current ^= 1;
+  }
+  // Flush the last queued buffer.
+  sceAudioOutOutput(m_handle, nullptr);
+}
diff --git a/Source/Core/AudioCommon/PS4AudioStream.h b/Source/Core/AudioCommon/PS4AudioStream.h
new file mode 100644
