+
+bool PS4CommandRecorderActive()
+{
+  return s_active;
+}
+
+void PS4CommandRecorderDrain()
+{
+  if (!s_active)
+    return;
+  // Everything published so far (any thread may drain, e.g. shader compiler threads destroying
+  // objects; only the video thread records).
+  const u64 target = s_write.load(std::memory_order_acquire);
+  if (s_read.load(std::memory_order_acquire) >= target)
+    return;
+  timespec t0, t1;
+  clock_gettime(CLOCK_MONOTONIC, &t0);
+  u32 spins = 0;
+  while (s_read.load(std::memory_order_acquire) < target)
+  {
+    WakeWorker();
+    Pause(spins);
+  }
+  clock_gettime(CLOCK_MONOTONIC, &t1);
+  ps4_wait_add(2, (t1.tv_sec - t0.tv_sec) * 1000000000ll + (t1.tv_nsec - t0.tv_nsec));
+}
+
+void PS4InstallCommandRecorder()
+{
+  if (!ps4_vk_thread || s_active)
+    return;
+  s_ring = static_cast<u8*>(::operator new(RING_SIZE, std::align_val_t{64}));
+  s_write = s_read = 0;
+  s_reserve = 0;
+  s_stop = false;
+
+#define PS4_SAVE(name) s_real.real_##name = ::name;
+  PS4_RECORDED(PS4_SAVE)
+  PS4_DRAINED(PS4_SAVE)
+#undef PS4_SAVE
+#define PS4_HOOK_REC(name) ::name = Rec_##name;
+  PS4_RECORDED(PS4_HOOK_REC)
+#undef PS4_HOOK_REC
+#define PS4_HOOK_DRAIN(name) ::name = Drain_##name;
+  PS4_DRAINED(PS4_HOOK_DRAIN)
+#undef PS4_HOOK_DRAIN
+
+  s_active = true;
+  if (ps4_vk_thread_mode != 2)
+    s_worker = std::thread(WorkerLoop);
+  ps4_boot_trace("vk_thread: Vulkan commands are recorded on a worker thread");
+}
+
+void PS4ShutdownCommandRecorder()
+{
+  if (!s_active)
+    return;
+  PS4CommandRecorderDrain();
+  s_stop.store(true, std::memory_order_seq_cst);
+  {
+    std::lock_guard lk(s_wake_mutex);
+    s_wake.notify_one();
+  }
+  if (s_worker.joinable())
+    s_worker.join();
+  s_active = false;
+
+#define PS4_RESTORE(name) ::name = s_real.real_##name;
+  PS4_RECORDED(PS4_RESTORE)
+  PS4_DRAINED(PS4_RESTORE)
+#undef PS4_RESTORE
+  ::operator delete(s_ring, std::align_val_t{64});
+  s_ring = nullptr;
+}
+}  // namespace Vulkan
