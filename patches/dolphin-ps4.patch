+// Video thread time per category since the last call (VideoCommon/PS4Profile.h), as
+// milliseconds per second of real time, with calls per second.
+static void LogProfile()
+{
+  static const char* const names[PS4_PROF_CATEGORY_COUNT] = {
+      "flush", "vtx-upload", "uniforms", "draw", "pipeline", "tex-cache",
+      "tex-upload", "compile", "link", "efb-copy", "efb-peek", "present",
+      "gpu-fifo", "cpu-wait", "tlbie", "pagetable"};
+  static unsigned long long s_ticks[PS4_PROF_CATEGORY_COUNT], s_count[PS4_PROF_CATEGORY_COUNT];
+  static unsigned long long s_tsc = 0;
+  static auto s_time = std::chrono::steady_clock::now();
+
+  const unsigned long long tsc = __rdtsc();
+  const auto time = std::chrono::steady_clock::now();
+  const double seconds = std::chrono::duration<double>(time - s_time).count();
+  if (s_tsc != 0 && seconds > 0.1)
+  {
+    const double ticks_per_ms = static_cast<double>(tsc - s_tsc) / (seconds * 1000.0);
+    char line[512];
+    int len = snprintf(line, sizeof(line), "prof (ms/s, calls/s):");
+    for (int i = 0; i < PS4_PROF_CATEGORY_COUNT; i++)
+    {
+      const unsigned long long ticks = ps4_prof_ticks[i], count = ps4_prof_count[i];
+      len += snprintf(line + len, sizeof(line) - len, " %s %.0f/%.0f", names[i],
+                      static_cast<double>(ticks - s_ticks[i]) / ticks_per_ms / seconds,
+                      static_cast<double>(count - s_count[i]) / seconds);
+      s_ticks[i] = ticks;
+      s_count[i] = count;
+    }
+    Platform::BootTrace(line);
+  }
+  else
+  {
+    for (int i = 0; i < PS4_PROF_CATEGORY_COUNT; i++)
+    {
+      s_ticks[i] = ps4_prof_ticks[i];
+      s_count[i] = ps4_prof_count[i];
+    }
+  }
+  s_tsc = tsc;
+  s_time = time;
+}
+
+void PlatformPS4::MainLoop()
+{
+  BootTrace("main loop");
+  int frame = 0;
+  const auto start = std::chrono::steady_clock::now();
+  // Hang watchdog: if emulated time stops advancing for ~10 s while running, every Dolphin
+  // thread's stack goes to /data/DolphinPS4/hang-stacks.txt (once per hang).
+  u64 watchdog_ticks = 0;
+  int watchdog_stalled = 0;
+  while (m_running.IsSet())
+  {
+    UpdateRunningFlag();
+    Core::HostDispatchJobs(Core::System::GetInstance());
+    std::this_thread::sleep_for(std::chrono::milliseconds(16));
+    // Keeps the FPS average fresh for the on-screen counter (VideoCommon/Present.cpp).
+    if (frame % 30 == 29)
+      Core::System::GetInstance().GetPerfMetrics().UpdateStats();
+    // cpu_clock=auto: the emulated CPU clock follows what the PS4 can run at full speed. A game
+    // gets as much of the GameCube's CPU as possible (up to cpu_clock_max, normally the real
+    // 100%), so light scenes reach the frame rates of real hardware, while heavy scenes get a lower
+    // clock (fewer frames) instead of running in slow motion. Checked every ~1 s: below 97%
+    // speed and the CPU thread at least 90% busy (it is the limit) -> 5 points lower; enough spare time for 5 points
+    // more (the CPU thread's work grows with the clock) -> 5 points higher, at most every ~2 s.
+    if (ps4_auto_clock > 0 && frame % 60 == 59)
+    {
+      static int s_since_change = 0;
+      auto& system = Core::System::GetInstance();
+      auto& perf = system.GetPerfMetrics();
+      const double speed = perf.GetSpeed(), max_speed = perf.GetMaxSpeed();
+      int clock = ps4_auto_clock;
+      s_since_change++;
+      // The CPU thread's own CPU time per wall time since the last check.
+      static double s_last_wall = 0, s_last_cpu = 0;
+      const double wall =
+          std::chrono::duration<double>(std::chrono::steady_clock::now().time_since_epoch())
+              .count();
+      const double cpu = ps4_thread_cpu_seconds(0);
+      const double cpu_busy = (s_last_wall > 0 && cpu > 0 && s_last_cpu > 0) ?
+                                  (cpu - s_last_cpu) / (wall - s_last_wall) :
+                                  1.0;
+      s_last_wall = wall;
+      s_last_cpu = cpu;
+      if (Core::GetState(system) == Core::State::Running && speed > 0.1)
+      {
+        if (speed < 0.97 && max_speed < 1.0 && cpu_busy >= 0.90 && clock > ps4_auto_clock_min)
+          clock = std::max(ps4_auto_clock_min, clock - 5);
+        else if (s_since_change >= 2 && max_speed * clock / (clock + 5.0) > 1.06 &&
+                 clock < ps4_auto_clock_max)
+          clock = std::min(ps4_auto_clock_max, clock + 5);
+      }
+      if (clock != ps4_auto_clock)
+      {
+        ps4_auto_clock = clock;
+        s_since_change = 0;
+        Config::SetBase(Config::MAIN_OVERCLOCK_ENABLE, clock != 100);
+        Config::SetBase(Config::MAIN_OVERCLOCK, clock / 100.0f);
+      }
+    }
+    // Monitor for the port: emulation speed, and flexible memory (what Piglet allocates from).
+    if (++frame % 120 == 0)
+    {
+      size_t flexible = 0;
+      using AvailableFlexibleFn = int32_t (*)(size_t*);
+      reinterpret_cast<AvailableFlexibleFn>(&sceKernelAvailableFlexibleMemorySize)(&flexible);
+      auto& perf = Core::System::GetInstance().GetPerfMetrics();
+      perf.UpdateStats();
+      const auto seconds = std::chrono::duration_cast<std::chrono::seconds>(
+                               std::chrono::steady_clock::now() - start)
+                               .count();
+      char line[2048];
+      // speed: emulated time per real time; max speed: what the CPU thread could reach if it
+      // never waited (below 100% means the emulated CPU itself is the bottleneck).
+      snprintf(line, sizeof(line),
+               "monitor: %lld s, speed %.0f%% (max %.0f%%), %.1f FPS, %.1f VPS, %zu MiB flexible "
+               "free, CPU core %d, %llu fastmem faults, GL shaders %d programs %d textures %d "
+               "(created %d, reused %d) fbos created %d, internal memory %llu KiB free, maps %lld "
+               "unmaps %lld costing %lld KiB, compiles %lld KiB, links %lld KiB",
+               static_cast<long long>(seconds), perf.GetSpeed() * 100.0,
+               perf.GetMaxSpeed() * 100.0, perf.GetFPS(), perf.GetVPS(),
+               flexible / (1024 * 1024), static_cast<int>(Config::Get(Config::MAIN_CPU_CORE)),
+               ps4_fault_count, ps4_gl_shaders, ps4_gl_programs, ps4_gl_textures,
+               ps4_gl_texture_creations, ps4_gl_texture_reuses, ps4_gl_fbo_creations,
+               ps4_internal_memory_free() / 1024, ps4_map_count, ps4_unmap_count,
+               ps4_map_internal_bytes / 1024, ps4_compile_internal_bytes / 1024,
+               ps4_link_internal_bytes / 1024);
+#ifdef HAS_VULKAN
+      {
+        // RADV on GNM: GPU progress (a stalled GPU shows completed falling behind) and memory.
+        u64 submitted, completed, bo_bytes, bo_count;
+        ac_ps4_get_stats(&submitted, &completed, &bo_bytes, &bo_count);
+        // GPU busy: share of GPU time spent on our submissions since the last report (from GPU
+        // timestamps; port/mesa/ac_ps4_drm.c).
+        static uint64_t s_last_busy = 0, s_last_span = 0;
+        uint64_t busy_ticks, span_ticks;
+        ac_ps4_get_gpu_busy(&busy_ticks, &span_ticks);
+        const double gpu_busy = span_ticks > s_last_span ?
+                                    100.0 * (busy_ticks - s_last_busy) / (span_ticks - s_last_span) :
+                                    -1.0;
+        s_last_busy = busy_ticks;
+        s_last_span = span_ticks;
+        const size_t used = strlen(line);
+        snprintf(line + used, sizeof(line) - used,
+                 ", gpu busy %.0f%%, gpu submitted %llu completed %llu, gpu memory %llu MiB in "
+                 "%llu buffers",
+                 gpu_busy,
+                 static_cast<unsigned long long>(submitted),
+                 static_cast<unsigned long long>(completed),
+                 static_cast<unsigned long long>(bo_bytes >> 20),
+                 static_cast<unsigned long long>(bo_count));
+      }
+#endif
+      {
+        // Page table fastmem: 16 KiB host pages that could / couldn't be fast-mapped.
+        const size_t used = strlen(line);
+        snprintf(line + used, sizeof(line) - used,
+                 ", page groups mapped %lld refused %lld, soft TLB hits %llu misses %llu",
+                 ps4_pt_groups_mapped, ps4_pt_groups_refused, ps4_soft_tlb_hits,
+                 ps4_soft_tlb_misses);
+      }
+      {
+        // How busy the CPU and video threads really are (their own CPU time per wall time):
+        // under ~95% at full speed means room for a higher cpu_clock.
+        static double s_last_wall = 0, s_last_cpu[2] = {};
+        const double wall = std::chrono::duration<double>(
+                                std::chrono::steady_clock::now().time_since_epoch())
+                                .count();
+        double busy[2] = {-1, -1};
+        for (int i = 0; i < 2; i++)
+        {
+          const double cpu = ps4_thread_cpu_seconds(i);
+          if (s_last_wall > 0 && cpu > 0 && s_last_cpu[i] > 0)
+            busy[i] = 100.0 * (cpu - s_last_cpu[i]) / (wall - s_last_wall);
+          s_last_cpu[i] = cpu;
+        }
+        s_last_wall = wall;
+        const size_t used = strlen(line);
+        snprintf(line + used, sizeof(line) - used,
+                 ", thread busy: cpu %.0f%% video %.0f%%, cpu clock %d%%", busy[0], busy[1],
+                 ps4_auto_clock > 0 ?
+                     ps4_auto_clock :
+                     static_cast<int>(Config::Get(Config::MAIN_OVERCLOCK_ENABLE) ?
+                                          Config::Get(Config::MAIN_OVERCLOCK) * 100 + 0.5f :
+                                          100));
+        // Scene composition, per second: what the video thread is working through.
+        static unsigned long long s_last_stats[8] = {};
+        unsigned long long rate[8];
+        const double period = s_last_wall > 0 ? 2.0 : 1.0;
+        for (int i = 0; i < 8; i++)
+        {
+          rate[i] = static_cast<unsigned long long>((ps4_scene_stats[i] - s_last_stats[i]) / period);
+          s_last_stats[i] = ps4_scene_stats[i];
+        }
+        // Where the threads wait, ms per second: the CPU thread for the GPU thread (FlushGpu), the
+        // GPU thread for work, the video thread for the Vulkan recording thread, GPU fences.
+        {
+          static long long s_last_waits[6] = {};
+          const size_t used3 = strlen(line);
+          long long ms[6];
+          for (int i = 0; i < 6; i++)
+          {
+            const long long total = ps4_wait_total(i);
+            const long long delta = total - s_last_waits[i];
+            ms[i] = static_cast<long long>(i == 5 ? delta / period : delta / period / 1000000);
+            s_last_waits[i] = total;
+          }
+          snprintf(line + used3, sizeof(line) - used3,
+                   ", waits ms/s: cpu-for-gpu %lld gpu-idle %lld vk-drain %lld fences %lld, "
+                   "compiles %lld/s %lld ms/s",
+                   ms[0], ms[1], ms[2], ms[3], ms[5], ms[4]);
+        }
+        const size_t used2 = strlen(line);
+        snprintf(line + used2, sizeof(line) - used2,
+                 ", per s: draws %llu prims %llu vertices %llu efb copies %llu peeks %llu "
+                 "pokes %llu reg loads %llu tex uploads %llu",
+                 rate[0], rate[1], rate[2], rate[6], rate[3], rate[4], rate[5], rate[7]);
+      }
+      BootTrace(line);
+      LogProfile();
+
+      auto& system = Core::System::GetInstance();
+      const u64 ticks = system.GetCoreTiming().GetTicks();
+      // Armed after 40 s: emulation legitimately stands still for a few seconds while booting.
+      if (seconds > 40 && Core::GetState(system) == Core::State::Running && ticks == watchdog_ticks)
+      {
+        if (++watchdog_stalled == 2)  // ~4 s: people close a frozen app quickly
+        {
+          char reason[96];
+          snprintf(reason, sizeof(reason), "emulation stalled ~4 s at %lld s",
+                   static_cast<long long>(seconds));
+          BootTrace("watchdog: emulation stalled, writing hang-stacks.txt");
+          ps4_dump_thread_stacks("/data/DolphinPS4/hang-stacks.txt", reason);
+        }
+      }
+      else
+      {
+        watchdog_stalled = 0;
+      }
+      watchdog_ticks = ticks;
+      // One self-test dump during normal play, so a broken dump shows up long before a real hang.
+      // (Self-test off: it signals every thread, and signals can make waits miss notifications.)
+      static bool s_dump_tested = true;
+      if (!s_dump_tested && seconds >= 60)
+      {
+        s_dump_tested = true;
+        BootTrace("watchdog: self-test dump");
+        ps4_dump_thread_stacks("/data/DolphinPS4/hang-stacks.txt", "self-test at 60 s (not a hang)");
+        BootTrace("watchdog: self-test dump done");
+      }
+    }
+    // Port diagnostics: a screenshot every ~10 s (User/ScreenShots) shows what Dolphin renders,
+    // independently of what reaches the TV.
+    static const bool s_screenshots = GetPS4Option("screenshots", "off") == "on";
+    if (s_screenshots && frame % 600 == 0 &&
+        Core::GetState(Core::System::GetInstance()) == Core::State::Running)
+    {
+      Core::SaveScreenShot(fmt::format("diag_{:03d}", frame / 60));
+      BootTrace("screenshot requested");
+    }
+  }
+}
