diff --git a/Source/Core/DolphinNoGUI/PlatformPS4.cpp b/Source/Core/DolphinNoGUI/PlatformPS4.cpp
new file mode 100644
index 0000000..2d545b1
--- /dev/null
+++ b/Source/Core/DolphinNoGUI/PlatformPS4.cpp
@@ -0,0 +1,299 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+// PS4 (OpenOrbis homebrew) platform: fullscreen Piglet (OpenGL ES) output, logging to
+// /data/DolphinPS4 and klog, and a command line built from /data/DolphinPS4 since PS4 apps are
+// started without arguments.
+
+#include "DolphinNoGUI/Platform.h"
+
+#include <algorithm>
+#include <array>
+#include <cstdarg>
+#include <cstdio>
+#include <filesystem>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include <orbis/Sysmodule.h>
+#include <orbis/libkernel.h>
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include "Common/Logging/LogManager.h"
+#include "Common/MsgHandler.h"
+#include "Core/Core.h"
+#include "Core/System.h"
+
+extern "C" int sceSystemServiceLoadExec(const char* path, char* const argv[]);
+extern "C" void ps4_boot_trace(const char* stage);
+
+namespace
+{
+constexpr char PS4_DATA_DIR_PATH[] = "/data/DolphinPS4";
+
+class PlatformPS4 final : public Platform
+{
+public:
+  bool Init() override;
+  void SetTitle(const std::string& title) override;
+  void MainLoop() override;
+
+  WindowSystemInfo GetWindowSystemInfo() const override;
+};
+
+void LoadSystemModules()
+{
+  // Calling into a system library whose module isn't loaded kills the app with
+  // PRX_NOT_RESOLVED_FUNCTION (love-ps4).
+  const std::array<std::pair<const char*, u32>, 5> modules = {{
+      {"SystemService", ORBIS_SYSMODULE_INTERNAL_SYSTEM_SERVICE},
+      {"UserService", ORBIS_SYSMODULE_INTERNAL_USER_SERVICE},
+      {"VideoOut", ORBIS_SYSMODULE_INTERNAL_VIDEO_OUT},
+      {"AudioOut", ORBIS_SYSMODULE_INTERNAL_AUDIOOUT},
+      {"Pad", ORBIS_SYSMODULE_INTERNAL_PAD},
+  }};
+  for (const auto& [name, id] : modules)
+  {
+    const int result = sceSysmoduleLoadModuleInternal(static_cast<OrbisSysModuleInternal>(id));
+    if (result != 0)
+      fprintf(stderr, "[dolphin] loading system module %s failed (%#x)\n", name, result);
+  }
+}
+
+// Panic alerts would normally be dialogs; log them and keep going.
+bool LogMessageAlert(const char* caption, const char* text, bool yes_no, Common::MsgType style)
+{
+  char line[2048];
+  snprintf(line, sizeof(line), "[dolphin] %s: %s\n", caption, text);
+  fputs(line, stderr);
+  sceKernelDebugOutText(0, line);
+  ps4_boot_trace(line);
+  return true;
+}
+
+bool PlatformPS4::Init()
+{
+  BootTrace("platform init");
+  LoadSystemModules();
+  Common::RegisterMsgAlertHandler(LogMessageAlert);
+  return true;
+}
+
+void PlatformPS4::SetTitle(const std::string& title)
+{
+  fprintf(stderr, "[dolphin] %s\n", title.c_str());
+}
+
+void PlatformPS4::MainLoop()
+{
+  BootTrace("main loop");
+  int frame = 0;
+  while (m_running.IsSet())
+  {
+    UpdateRunningFlag();
+    Core::HostDispatchJobs(Core::System::GetInstance());
+    std::this_thread::sleep_for(std::chrono::milliseconds(16));
+    // Memory monitor for the port: flexible memory is what Piglet (GPU) allocates from.
+    if (++frame % 120 == 0)
+    {
+      size_t flexible = 0;
+      using AvailableFlexibleFn = int32_t (*)(size_t*);
+      reinterpret_cast<AvailableFlexibleFn>(&sceKernelAvailableFlexibleMemorySize)(&flexible);
+      char line[96];
+      snprintf(line, sizeof(line), "monitor: %d s, %zu MiB flexible memory free", frame / 60,
+               flexible / (1024 * 1024));
+      BootTrace(line);
+    }
+  }
+}
+
+WindowSystemInfo PlatformPS4::GetWindowSystemInfo() const
+{
+  WindowSystemInfo wsi;
+  wsi.type = WindowSystemType::Orbis;
+  wsi.display_connection = nullptr;
+  wsi.render_window = nullptr;
+  wsi.render_surface = nullptr;
+  return wsi;
+}
+
+std::string FindGame()
+{
+  // /data/DolphinPS4/boot.txt: path of the game to start (first line).
+  if (FILE* file = fopen((std::string(PS4_DATA_DIR_PATH) + "/boot.txt").c_str(), "r"))
+  {
+    char line[1024] = {};
+    const bool read = fgets(line, sizeof(line), file) != nullptr;
+    fclose(file);
+    std::string path = read ? line : "";
+    while (!path.empty() && (path.back() == '\n' || path.back() == '\r' || path.back() == ' '))
+      path.pop_back();
+    if (!path.empty())
+      return path;
+  }
+
+  // Otherwise the first game in /data/DolphinPS4/games, in name order.
+  const std::array<std::string, 11> extensions = {".iso", ".gcm", ".ciso", ".gcz", ".wbfs",
+                                                  ".wia", ".rvz", ".dol", ".elf", ".wad", ".nkit.iso"};
+  std::vector<std::string> games;
+  std::error_code error;
+  for (const auto& entry :
+       std::filesystem::directory_iterator(std::string(PS4_DATA_DIR_PATH) + "/games", error))
+  {
+    std::string name = entry.path().filename().string();
+    std::string lower = name;
+    std::transform(lower.begin(), lower.end(), lower.begin(), ::tolower);
+    for (const std::string& extension : extensions)
+    {
+      if (lower.size() > extension.size() &&
+          lower.compare(lower.size() - extension.size(), extension.size(), extension) == 0)
+      {
+        games.push_back(entry.path().string());
+        break;
+      }
+    }
+  }
+  std::sort(games.begin(), games.end());
+  return games.empty() ? std::string() : games.front();
+}
+
+// Controller mappings for the DualShock 4 (ciface::PS4Pad), written on first launch only so that
+// user edits are kept.
+constexpr char GCPAD_DEFAULTS[] = R"([GCPad1]
+Device = PS4/0/DualShock 4
+Buttons/A = Cross
+Buttons/B = Square
+Buttons/X = Circle
+Buttons/Y = Triangle
+Buttons/Z = R1
+Buttons/Start = Options
+Main Stick/Up = `Left Y-`
+Main Stick/Down = `Left Y+`
+Main Stick/Left = `Left X-`
+Main Stick/Right = `Left X+`
+C-Stick/Up = `Right Y-`
+C-Stick/Down = `Right Y+`
+C-Stick/Left = `Right X-`
+C-Stick/Right = `Right X+`
+Triggers/L = `L2 Click`
+Triggers/R = `R2 Click`
+Triggers/L-Analog = L2
+Triggers/R-Analog = R2
+D-Pad/Up = `Pad N`
+D-Pad/Down = `Pad S`
+D-Pad/Left = `Pad W`
+D-Pad/Right = `Pad E`
+Rumble/Motor = `Motor L`
+)";
+
+constexpr char WIIMOTE_DEFAULTS[] = R"([Wiimote1]
+Device = PS4/0/DualShock 4
+Buttons/A = Cross
+Buttons/B = R2
+Buttons/1 = Square
+Buttons/2 = Triangle
+Buttons/- = L1
+Buttons/+ = Options
+Buttons/Home = Touchpad
+D-Pad/Up = `Pad N`
+D-Pad/Down = `Pad S`
+D-Pad/Left = `Pad W`
+D-Pad/Right = `Pad E`
+IR/Up = `Right Y-`
+IR/Down = `Right Y+`
+IR/Left = `Right X-`
+IR/Right = `Right X+`
+Shake/X = R3
+Shake/Y = R3
+Shake/Z = R3
+Rumble/Motor = `Motor L`
+Extension = Nunchuk
+Nunchuk/Buttons/C = L1
+Nunchuk/Buttons/Z = L2
+Nunchuk/Stick/Up = `Left Y-`
+Nunchuk/Stick/Down = `Left Y+`
+Nunchuk/Stick/Left = `Left X-`
+Nunchuk/Stick/Right = `Left X+`
+)";
+
+void WriteDefaultFile(const std::string& path, const char* contents)
+{
+  struct stat st;
+  if (stat(path.c_str(), &st) == 0)
+    return;
+  if (FILE* file = fopen(path.c_str(), "w"))
+  {
+    fputs(contents, file);
+    fclose(file);
+  }
+}
+
+void WriteDefaultConfig(const std::string& user_dir)
+{
+  mkdir(user_dir.c_str(), 0777);
+  mkdir((user_dir + "/Config").c_str(), 0777);
+  WriteDefaultFile(user_dir + "/Config/GCPadNew.ini", GCPAD_DEFAULTS);
+  WriteDefaultFile(user_dir + "/Config/WiimoteNew.ini", WIIMOTE_DEFAULTS);
+}
+
+void OnExit()
+{
+  // The raw exit syscall isn't allowed for apps: ask the system to close us.
+  fflush(stderr);
+  sceSystemServiceLoadExec("exit", nullptr);
+  for (;;)
+    sceKernelUsleep(100000);
+}
+
+}  // namespace
+
+std::unique_ptr<Platform> Platform::CreatePS4Platform()
+{
+  return std::make_unique<PlatformPS4>();
+}
+
+void Platform::BootTrace(const char* stage)
+{
+  ps4_boot_trace(stage);
+}
+
+std::vector<std::string> Platform::GetPS4Arguments()
+{
+  BootTrace("main");
+  mkdir(PS4_DATA_DIR_PATH, 0777);
+  mkdir((std::string(PS4_DATA_DIR_PATH) + "/games").c_str(), 0777);
+
+  // stdout/stderr go nowhere on PS4: send them to a file, unbuffered so it survives a crash.
+  // (Not freopen: the OpenOrbis libc's freopen frees the static stderr FILE and output is lost.)
+  const int log_fd =
+      open((std::string(PS4_DATA_DIR_PATH) + "/dolphin.log").c_str(), O_WRONLY | O_CREAT | O_TRUNC, 0666);
+  if (log_fd >= 0)
+  {
+    dup2(log_fd, STDOUT_FILENO);
+    dup2(log_fd, STDERR_FILENO);
+    close(log_fd);
+  }
+  setvbuf(stdout, nullptr, _IONBF, 0);
+  setvbuf(stderr, nullptr, _IONBF, 0);
+  atexit(OnExit);
+  BootTrace("log opened");
+
+  const std::string user_dir = std::string(PS4_DATA_DIR_PATH) + "/User";
+  WriteDefaultConfig(user_dir);
+  std::vector<std::string> args = {"dolphin-emu-nogui", "--platform=ps4", "--user=" + user_dir};
+  const std::string game = FindGame();
+  if (game.empty())
+  {
+    fprintf(stderr, "[dolphin] no game: put one in %s/games or its path in %s/boot.txt\n",
+            PS4_DATA_DIR_PATH, PS4_DATA_DIR_PATH);
+  }
+  else
+  {
+    fprintf(stderr, "[dolphin] booting %s\n", game.c_str());
+    args.push_back("--exec=" + game);
+  }
+  return args;
+}
