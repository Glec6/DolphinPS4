+  const GLenum error = glGetError();
+
+  glBindFramebuffer(GL_READ_FRAMEBUFFER, prev_read);
+  if (fbo)
+    glDeleteFramebuffers(1, &fbo);
+
+  char line[192];
+  snprintf(line, sizeof(line),
+           "pixel %s (%dx%d at %d,%d, target 0x%x): rgba %u %u %u %u, fbo 0x%x, GL error 0x%x", name,
+           texture ? static_cast<int>(texture->GetWidth()) : 0,
+           texture ? static_cast<int>(texture->GetHeight()) : 0, x, y,
+           texture ? static_cast<const OGL::OGLTexture*>(texture)->GetGLTarget() : 0, pixel[0],
