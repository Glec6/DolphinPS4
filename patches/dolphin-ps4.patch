diff --git a/Source/Core/Common/MemArenaPS4.cpp b/Source/Core/Common/MemArenaPS4.cpp
new file mode 100644
index 0000000..ddb352f
--- /dev/null
+++ b/Source/Core/Common/MemArenaPS4.cpp
@@ -0,0 +1,228 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+// PS4 MemArena. The PS4 kernel can't reserve gigabytes with mmap(PROT_NONE), and apps have no
+// anonymous shared memory that can be mapped at fixed addresses. Instead:
+//   - the memory segment is a block of direct (physical) memory,
+//   - views of it are direct memory mappings, which can alias each other,
+//   - the fastmem region is a sceKernelReserveVirtualRange reservation that views are mapped
+//     into with MAP_FIXED.
+// All of this was verified on hardware (FW 12.00, GoldHEN). Mappings work at 16 KiB granularity.
+
+#include "Common/MemArena.h"
+
+#include <cerrno>
+#include <cstddef>
+#include <cstdint>
+
+#include <sys/mman.h>
+#include <sys/types.h>
+
+#include "Common/Assert.h"
+#include "Common/CommonTypes.h"
+#include "Common/Logging/Log.h"
+#include "Common/MsgHandler.h"
+
+// Declared by hand: several OpenOrbis prototypes are wrong.
+extern "C" {
+size_t sceKernelGetDirectMemorySize();
+int32_t sceKernelAllocateDirectMemory(off_t search_start, off_t search_end, size_t length,
+                                      size_t alignment, int32_t memory_type, off_t* physical_out);
+int32_t sceKernelReleaseDirectMemory(off_t start, size_t length);
+int32_t sceKernelMapDirectMemory(void** address, size_t length, int32_t protection, int32_t flags,
+                                 off_t direct_memory_start, size_t alignment);
+int32_t sceKernelReserveVirtualRange(void** address, size_t length, int32_t flags,
+                                     size_t alignment);
+int32_t sceKernelMunmap(void* address, size_t length);
+int32_t sceKernelMprotect(const void* address, size_t length, int32_t protection);
+}
+
+namespace
+{
+constexpr size_t PS4_PAGE_SIZE = 0x4000;
+constexpr size_t PS4_RESERVE_ALIGNMENT = 0x10000;
+constexpr int32_t SCE_KERNEL_WB_ONION = 0;
+constexpr int32_t SCE_KERNEL_MAP_FIXED = 0x10;
+constexpr int32_t SCE_KERNEL_PROT_CPU_READ = 0x1;
+constexpr int32_t SCE_KERNEL_PROT_CPU_RW = 0x3;
+
+size_t AlignUp(size_t value, size_t alignment)
+{
+  return (value + alignment - 1) & ~(alignment - 1);
+}
+
+int32_t Protection(bool writeable)
+{
+  return writeable ? SCE_KERNEL_PROT_CPU_RW : SCE_KERNEL_PROT_CPU_READ;
+}
+}  // namespace
+
+namespace Common
+{
+MemArena::MemArena() = default;
+MemArena::~MemArena() = default;
+
+void MemArena::GrabSHMSegment(size_t size, std::string_view base_name)
+{
+  const size_t aligned_size = AlignUp(size, PS4_PAGE_SIZE);
+  off_t physical = 0;
+  const int32_t result =
+      sceKernelAllocateDirectMemory(0, static_cast<off_t>(sceKernelGetDirectMemorySize()),
+                                    aligned_size, PS4_RESERVE_ALIGNMENT, SCE_KERNEL_WB_ONION,
+                                    &physical);
+  if (result != 0)
+  {
+    ERROR_LOG_FMT(MEMMAP, "sceKernelAllocateDirectMemory({} bytes) for {} failed: {:#x}",
+                  aligned_size, base_name, static_cast<u32>(result));
+    return;
+  }
+  m_direct_memory = physical;
+  m_direct_memory_size = aligned_size;
+}
+
+void MemArena::ReleaseSHMSegment()
+{
+  if (m_direct_memory >= 0)
+    sceKernelReleaseDirectMemory(m_direct_memory, m_direct_memory_size);
+  m_direct_memory = -1;
+  m_direct_memory_size = 0;
+}
+
+void* MemArena::CreateView(s64 offset, size_t size)
+{
+  void* address = nullptr;
+  const int32_t result =
+      sceKernelMapDirectMemory(&address, AlignUp(size, PS4_PAGE_SIZE), SCE_KERNEL_PROT_CPU_RW, 0,
+                               m_direct_memory + offset, PS4_PAGE_SIZE);
+  if (result != 0)
+  {
+    NOTICE_LOG_FMT(MEMMAP, "sceKernelMapDirectMemory failed: {:#x}", static_cast<u32>(result));
+    return nullptr;
+  }
+  return address;
+}
+
+void MemArena::ReleaseView(void* view, size_t size)
+{
+  sceKernelMunmap(view, AlignUp(size, PS4_PAGE_SIZE));
+}
+
+u8* MemArena::ReserveMemoryRegion(size_t memory_size)
+{
+  void* base = nullptr;
+  const int32_t result =
+      sceKernelReserveVirtualRange(&base, memory_size, 0, PS4_RESERVE_ALIGNMENT);
+  if (result != 0)
+  {
+    PanicAlertFmt("Failed to reserve {} bytes of address space: {:#x}", memory_size,
+                  static_cast<u32>(result));
+    return nullptr;
+  }
+  m_reserved_region = base;
+  m_reserved_region_size = memory_size;
+  return static_cast<u8*>(base);
+}
+
+void MemArena::ReleaseMemoryRegion()
+{
+  if (m_reserved_region)
+  {
+    sceKernelMunmap(m_reserved_region, m_reserved_region_size);
+    m_reserved_region = nullptr;
+    m_reserved_region_size = 0;
+  }
+}
+
+void* MemArena::MapInMemoryRegion(s64 offset, size_t size, void* base, bool writeable)
+{
+  void* address = base;
+  const int32_t result =
+      sceKernelMapDirectMemory(&address, AlignUp(size, PS4_PAGE_SIZE), Protection(writeable),
+                               SCE_KERNEL_MAP_FIXED, m_direct_memory + offset, PS4_PAGE_SIZE);
+  if (result != 0)
+  {
+    NOTICE_LOG_FMT(MEMMAP, "sceKernelMapDirectMemory at {} failed: {:#x}", base,
+                   static_cast<u32>(result));
+    return nullptr;
+  }
+  return address;
+}
+
+bool MemArena::ChangeMappingProtection(void* view, size_t size, bool writeable)
+{
+  const int32_t result =
+      sceKernelMprotect(view, AlignUp(size, PS4_PAGE_SIZE), Protection(writeable));
+  if (result != 0)
+    NOTICE_LOG_FMT(MEMMAP, "sceKernelMprotect failed: {:#x}", static_cast<u32>(result));
+  return result == 0;
+}
+
+void MemArena::UnmapFromMemoryRegion(void* view, size_t size)
+{
+  const size_t aligned_size = AlignUp(size, PS4_PAGE_SIZE);
+  sceKernelMunmap(view, aligned_size);
+  // Reserve the hole again so nothing else gets mapped inside the fastmem region.
+  void* address = view;
+  const int32_t result =
+      sceKernelReserveVirtualRange(&address, aligned_size, SCE_KERNEL_MAP_FIXED, PS4_PAGE_SIZE);
+  if (result != 0 || address != view)
+  {
+    NOTICE_LOG_FMT(MEMMAP, "re-reserving {} after unmapping failed: {:#x}", view,
+                   static_cast<u32>(result));
+  }
+}
+
+size_t MemArena::GetPageSize() const
+{
+  return PS4_PAGE_SIZE;
+}
+
+// The PS4 has no MAP_NORESERVE, but anonymous mappings are committed on first touch (verified up
+// to 1 GiB). Larger requests fail, and callers fall back (e.g. the JIT's entry points map).
+LazyMemoryRegion::LazyMemoryRegion() = default;
+
+LazyMemoryRegion::~LazyMemoryRegion()
+{
+  Release();
+}
+
+void* LazyMemoryRegion::Create(size_t size)
+{
+  ASSERT(!m_memory);
+
+  if (size == 0)
+    return nullptr;
+
+  void* memory = mmap(nullptr, size, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANON, -1, 0);
+  if (memory == MAP_FAILED)
+  {
+    NOTICE_LOG_FMT(MEMMAP, "Memory allocation of {} bytes failed.", size);
+    return nullptr;
+  }
+
+  m_memory = memory;
+  m_size = size;
+
+  return memory;
+}
+
+void LazyMemoryRegion::Clear()
+{
+  ASSERT(m_memory);
+
+  void* new_memory =
+      mmap(m_memory, m_size, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANON | MAP_FIXED, -1, 0);
+  ASSERT(new_memory == m_memory);
+}
+
+void LazyMemoryRegion::Release()
+{
+  if (m_memory)
+  {
+    munmap(m_memory, m_size);
+    m_memory = nullptr;
+    m_size = 0;
+  }
+}
+
+}  // namespace Common
