+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+// PS4: Vulkan command recording thread (ps4.ini vk_thread=on).
+//
+// The video thread emulates the GameCube GPU and records Vulkan commands. On the PS4's Jaguar
+// cores RADV's per-draw work (state emission, descriptors, the draw packets) was ~16% of the video
+// thread in draw-heavy scenes (Crash Bandicoot: ~4000 draws per frame), while three cores sat
+// idle. Here the video thread only queues the calls Dolphin makes (a few dozen bytes each, into a
+// ring buffer); a worker thread on its own core replays them into RADV and submits.
+//
+// Ordering: everything that records into or submits command buffers goes through the queue in
+// program order. Calls that observe the results (fence waits, query results, idle waits), destroy
+// objects queued commands may still reference, or present (the PS4 flip) first wait until the
+// worker has replayed everything queued ("drain"). Calls that only create objects or update
+// descriptor sets run directly: Dolphin never changes a descriptor set after binding it, and
+// resets descriptor pools only after waiting for the command buffers that used them.
+//
+// Only the video thread may record (Dolphin's own submission thread is disabled with this).
+
+#include "VideoBackends/Vulkan/PS4CommandRecorder.h"
+
+#include <pthread.h>
+#include <time.h>
+
+#include <atomic>
+#include <condition_variable>
+#include <cstring>
+#include <mutex>
+#include <thread>
+
+#include "Common/CommonTypes.h"
+#include "Common/Logging/Log.h"
+#include "Common/Thread.h"
+#include "VideoBackends/Vulkan/VulkanLoader.h"
+
+extern "C" {
+int ps4_vk_thread = 0;       // ps4.ini vk_thread=on
+int ps4_vk_thread_core = 5;  // ps4.ini vk_thread_core
+// ps4.ini vk_thread_mode (diagnostics): 0 async (the worker replays in parallel), 1 sync (the
+// worker replays each call while the video thread waits), 2 inline (recorded calls are replayed
+// right away on the video thread - tests the record/replay itself, no second thread).
+int ps4_vk_thread_mode = 0;
+}
+extern "C" void ps4_boot_trace(const char* stage);
+extern "C" void ps4_wait_add(int slot, long long ns);  // port/ps4_sampler.cpp
+
