+};
+
+void LoadSystemModules()
+{
+  // Calling into a system library whose module isn't loaded kills the app with
+  // PRX_NOT_RESOLVED_FUNCTION (love-ps4).
+  const std::array<std::pair<const char*, u32>, 5> modules = {{
+      {"SystemService", ORBIS_SYSMODULE_INTERNAL_SYSTEM_SERVICE},
+      {"UserService", ORBIS_SYSMODULE_INTERNAL_USER_SERVICE},
+      {"VideoOut", ORBIS_SYSMODULE_INTERNAL_VIDEO_OUT},
+      {"AudioOut", ORBIS_SYSMODULE_INTERNAL_AUDIOOUT},
+      {"Pad", ORBIS_SYSMODULE_INTERNAL_PAD},
+  }};
+  for (const auto& [name, id] : modules)
+  {
+    const int result = sceSysmoduleLoadModuleInternal(static_cast<OrbisSysModuleInternal>(id));
+    if (result != 0)
+      fprintf(stderr, "[dolphin] loading system module %s failed (%#x)\n", name, result);
+  }
+}
+
+// Panic alerts would normally be dialogs; log them and keep going.
+bool LogMessageAlert(const char* caption, const char* text, bool yes_no, Common::MsgType style)
+{
+  char line[2048];
+  snprintf(line, sizeof(line), "[dolphin] %s: %s\n", caption, text);
+  fputs(line, stderr);
+  sceKernelDebugOutText(0, line);
+  ps4_boot_trace(line);
+  return true;
+}
+
+bool PlatformPS4::Init()
+{
+  BootTrace("platform init");
+  LoadSystemModules();
+  Common::RegisterMsgAlertHandler(LogMessageAlert);
+  return true;
+}
