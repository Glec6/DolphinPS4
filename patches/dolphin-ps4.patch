+// ---------------------------------------------------------------------------------------------
+// The queue: a single-producer (video thread), single-consumer (worker) ring of records
+// {u32 size, u32 op, payload}, 16-byte aligned, never wrapping inside a record.
+constexpr size_t RING_SIZE = 16u << 20;
+constexpr size_t RING_MASK = RING_SIZE - 1;
+
+struct Header
+{
+  u32 size;
+  u32 op;
+};
+
+u8* s_ring = nullptr;
+alignas(64) std::atomic<u64> s_write{0};  // published by the producer
+alignas(64) std::atomic<u64> s_read{0};   // published by the consumer
+alignas(64) u64 s_reserve = 0;            // producer-local
+u32 s_pending = 0;                        // size of the record being written
+std::atomic<bool> s_sleeping{false};
+std::atomic<bool> s_stop{false};
+std::mutex s_wake_mutex;
+std::condition_variable s_wake;
+std::thread s_worker;
+bool s_active = false;
+
+void WakeWorker()
+{
+  if (s_sleeping.load(std::memory_order_seq_cst))
+  {
+    std::lock_guard lk(s_wake_mutex);
+    s_wake.notify_one();
+  }
+}
