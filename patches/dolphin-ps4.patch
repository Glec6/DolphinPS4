+#ifdef __ORBIS__
+void ShaderCache::PS4FlushDiskCaches()
+{
+  if (!g_ActiveConfig.bShaderCache)
+    return;
+  // Only when something new was compiled since the last flush.
+  static size_t s_last_count = 0;
+  const size_t count = m_vs_cache.shader_map.size() + m_gs_cache.shader_map.size() +
+                      m_ps_cache.shader_map.size() + m_uber_vs_cache.shader_map.size() +
+                      m_uber_ps_cache.shader_map.size() + m_gx_pipeline_cache.size() +
+                      m_gx_uber_pipeline_cache.size();
+  if (count == s_last_count)
+    return;
+  s_last_count = count;
+  m_vs_cache.disk_cache.Sync();
+  m_gs_cache.disk_cache.Sync();
+  m_ps_cache.disk_cache.Sync();
+  m_uber_vs_cache.disk_cache.Sync();
+  m_uber_ps_cache.disk_cache.Sync();
+  m_gx_pipeline_disk_cache.Sync();
+  m_gx_uber_pipeline_disk_cache.Sync();
+  if (m_gx_pipeline_uid_cache_file.IsOpen())
+    m_gx_pipeline_uid_cache_file.Flush();
+  if (s_ps4_save_backend_cache)
+    s_ps4_save_backend_cache();
+  INFO_LOG_FMT(VIDEO, "PS4: flushed shader caches ({} shaders and pipelines)", count);
+}
+#endif
