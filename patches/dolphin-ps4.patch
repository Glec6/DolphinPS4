+int ps4_render_diagnostics = 0;
+static int s_sampled_draws = 0;
+static bool PS4ShouldSampleDraw(int draw)
+{
+  // Every 3000th draw (up to 60): covers menus and levels, not just the first frames.
+  return ps4_render_diagnostics && s_sampled_draws < 60 && draw % 3000 == 0;
+}
