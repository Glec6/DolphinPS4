+void LoadSystemModules()
+{
+  // Calling into a system library whose module isn't loaded kills the app with
+  // PRX_NOT_RESOLVED_FUNCTION (love-ps4).
+  const std::array<std::pair<const char*, u32>, 5> modules = {{
+      {"SystemService", ORBIS_SYSMODULE_INTERNAL_SYSTEM_SERVICE},
+      {"UserService", ORBIS_SYSMODULE_INTERNAL_USER_SERVICE},
+      {"VideoOut", ORBIS_SYSMODULE_INTERNAL_VIDEO_OUT},
+      {"AudioOut", ORBIS_SYSMODULE_INTERNAL_AUDIOOUT},
+      {"Pad", ORBIS_SYSMODULE_INTERNAL_PAD},
+  }};
+  for (const auto& [name, id] : modules)
+  {
+    const int result = sceSysmoduleLoadModuleInternal(static_cast<OrbisSysModuleInternal>(id));
+    if (result != 0)
+      fprintf(stderr, "[dolphin] loading system module %s failed (%#x)\n", name, result);
+  }
+}
+
+// Panic alerts would normally be dialogs; log them and keep going.
+bool LogMessageAlert(const char* caption, const char* text, bool yes_no, Common::MsgType style)
+{
+  static std::atomic<unsigned> s_alerts{0};
+  const unsigned alert = s_alerts.fetch_add(1, std::memory_order_relaxed) + 1;
+  if (alert > 40 && alert % 1000 != 0)
+    return true;
+  char line[2048];
+  snprintf(line, sizeof(line), "[dolphin] alert #%u %s: %s\n", alert, caption, text);
+  fputs(line, stderr);
+  sceKernelDebugOutText(0, line);
+  ps4_boot_trace(line);
+  return true;
+}
+
+// Port measurement: which allocations draw from libkernel's internal memory, the pool Piglet's
+// program links and shader compiles exhaust? (1) the system C library's own malloc, (2) pthread
+// mutexes. If (1) does, the system malloc-replacement table could move Piglet's allocations
+// into our heap.
+static void ProbeInternalMemory()
+{
+  const auto free_now = [] { return static_cast<long long>(ps4_internal_memory_free()); };
+  char line[192];
+
+  int libc = static_cast<int>(sceKernelLoadStartModule("libSceLibcInternal.sprx", 0, nullptr, 0, nullptr,
+                                            nullptr));
+  if (libc <= 0)
+  {
+    libc = static_cast<int>(sceKernelLoadStartModule("/system/common/lib/libSceLibcInternal.sprx", 0,
+                                                     nullptr, 0, nullptr, nullptr));
+  }
+  void* (*sys_malloc)(size_t) = nullptr;
+  void (*sys_free)(void*) = nullptr;
+  if (libc > 0)
+  {
+    sceKernelDlsym(libc, "malloc", reinterpret_cast<void**>(&sys_malloc));
+    sceKernelDlsym(libc, "free", reinterpret_cast<void**>(&sys_free));
+  }
+  if (sys_malloc && sys_free)
+  {
+    long long before = free_now();
+    void* small[64];
+    for (void*& block : small)
+      block = sys_malloc(16 * 1024);
+    const long long after_small = free_now();
+    void* big = sys_malloc(4 * 1024 * 1024);
+    const long long after_big = free_now();
+    snprintf(line, sizeof(line),
+             "probe: system malloc 64 x 16 KiB -> internal memory %+lld KiB, 4 MiB -> %+lld KiB",
+             (after_small - before) / 1024, (after_big - after_small) / 1024);
+    Platform::BootTrace(line);
+    sys_free(big);
+    for (void* block : small)
+      sys_free(block);
+    snprintf(line, sizeof(line), "probe: after free, internal memory %+lld KiB vs start",
+             (free_now() - before) / 1024);
+    Platform::BootTrace(line);
+  }
+  else
+  {
+    snprintf(line, sizeof(line), "probe: libSceLibcInternal malloc not found (module %#x)",
+             static_cast<unsigned>(libc));
+    Platform::BootTrace(line);
+  }
+
+  const long long before = free_now();
+  static pthread_mutex_t mutexes[200];
+  for (pthread_mutex_t& mutex : mutexes)
+  {
+    pthread_mutex_init(&mutex, nullptr);
+    pthread_mutex_lock(&mutex);
+    pthread_mutex_unlock(&mutex);
+  }
+  const long long after = free_now();
+  for (pthread_mutex_t& mutex : mutexes)
+    pthread_mutex_destroy(&mutex);
+  snprintf(line, sizeof(line),
+           "probe: 200 pthread mutexes -> internal memory %+lld KiB (%+lld after destroy)",
+           (after - before) / 1024, (free_now() - before) / 1024);
+  Platform::BootTrace(line);
+}
