 std::unique_ptr<VKPipeline> VKPipeline::Create(const AbstractPipelineConfig& config)
+#ifdef __ORBIS__
+{
+  // How long pipeline compiles block the video thread (monitor: "compiles"); background compiler
+  // threads aren't counted.
+  if (!Core::IsGPUThread())
+    return CreateImpl(config);
+  timespec t0, t1;
+  clock_gettime(CLOCK_MONOTONIC, &t0);
+  std::unique_ptr<VKPipeline> pipeline = CreateImpl(config);
