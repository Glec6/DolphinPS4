+// ---------------------------------------------------------------------------------------------
+// Recording thunks (video thread).
+VKAPI_ATTR VkResult VKAPI_CALL Rec_vkBeginCommandBuffer(VkCommandBuffer cb,
+                                                        const VkCommandBufferBeginInfo* info)
+{
+  Writer w(Begin(OP_BeginCommandBuffer, sizeof(cb) + sizeof(VkCommandBufferUsageFlags)));
+  w.Put(cb);
+  w.Put(info->flags);
+  Commit();
+  return VK_SUCCESS;
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL Rec_vkEndCommandBuffer(VkCommandBuffer cb)
+{
+  Writer w(Begin(OP_EndCommandBuffer, sizeof(cb)));
+  w.Put(cb);
+  Commit();
+  return VK_SUCCESS;
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL Rec_vkResetCommandPool(VkDevice device, VkCommandPool pool,
+                                                      VkCommandPoolResetFlags flags)
+{
+  Writer w(Begin(OP_ResetCommandPool, sizeof(device) + sizeof(pool) + sizeof(flags)));
+  w.Put(device);
+  w.Put(pool);
+  w.Put(flags);
+  Commit();
+  return VK_SUCCESS;
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL Rec_vkResetFences(VkDevice device, uint32_t count,
+                                                 const VkFence* fences)
+{
+  Writer w(Begin(OP_ResetFences, sizeof(device) + 4 + sizeof(VkFence) * count));
+  w.Put(device);
+  w.Put(count);
+  w.PutArray(fences, count);
+  Commit();
+  return VK_SUCCESS;
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL Rec_vkQueueSubmit(VkQueue queue, uint32_t count,
+                                                 const VkSubmitInfo* submits, VkFence fence)
+{
+  size_t size = sizeof(queue) + sizeof(fence) + 4;
+  bool simple = count <= 4;
+  for (u32 i = 0; i < count; i++)
+  {
+    const VkSubmitInfo& s = submits[i];
+    simple &= s.pNext == nullptr;
+    size += 12 + s.waitSemaphoreCount * (sizeof(VkSemaphore) + sizeof(VkPipelineStageFlags)) +
+            s.commandBufferCount * sizeof(VkCommandBuffer) +
+            s.signalSemaphoreCount * sizeof(VkSemaphore);
+  }
+  if (!simple)
+  {
+    // Not expected from Dolphin: submit directly, in order.
+    PS4CommandRecorderDrain();
+    return s_real.real_vkQueueSubmit(queue, count, submits, fence);
+  }
+  Writer w(Begin(OP_QueueSubmit, size));
+  w.Put(queue);
+  w.Put(fence);
+  w.Put(count);
+  for (u32 i = 0; i < count; i++)
+  {
+    const VkSubmitInfo& s = submits[i];
+    w.Put(s.waitSemaphoreCount);
+    w.PutArray(s.pWaitSemaphores, s.waitSemaphoreCount);
+    w.PutArray(s.pWaitDstStageMask, s.waitSemaphoreCount);
+    w.Put(s.commandBufferCount);
+    w.PutArray(s.pCommandBuffers, s.commandBufferCount);
+    w.Put(s.signalSemaphoreCount);
+    w.PutArray(s.pSignalSemaphores, s.signalSemaphoreCount);
+  }
+  Commit();
+  return VK_SUCCESS;
+}
+
+VKAPI_ATTR void VKAPI_CALL Rec_vkCmdBindPipeline(VkCommandBuffer cb, VkPipelineBindPoint point,
+                                                 VkPipeline pipeline)
+{
+  Writer w(Begin(OP_CmdBindPipeline, sizeof(cb) + sizeof(point) + sizeof(pipeline)));
+  w.Put(cb);
+  w.Put(point);
+  w.Put(pipeline);
+  Commit();
+}
