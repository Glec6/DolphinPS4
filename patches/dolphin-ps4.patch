+#ifdef __ORBIS__
+// Port diagnostics: for a sample of game draws, count the pixels Piglet lets through and log the
+// state that decides it. If none pass, the draw is repeated with depth test, scissor and culling
+// off to see which of them is discarding everything.
+// Set from ps4.ini (diagnostics=on) by DolphinNoGUI; the probes below stall the GPU.
+extern "C" int ps4_render_diagnostics;
+int ps4_render_diagnostics = 0;
+static int s_sampled_draws = 0;
+static bool PS4ShouldSampleDraw(int draw)
+{
+  return ps4_render_diagnostics && s_sampled_draws < 24 && (draw >= 300 && draw % 50 == 0);
+}
+
+static void PS4LogDrawState(int draw, GLenum primitive, u32 num_indices, GLuint samples,
+                            GLuint samples_unrestricted)
+{
+  GLint viewport[4] = {}, scissor[4] = {}, program = 0, fbo = 0, depth_func = 0;
+  GLboolean color_mask[4] = {}, depth_mask = 0;
+  GLfloat depth_range[2] = {};
+  glGetIntegerv(GL_VIEWPORT, viewport);
+  glGetIntegerv(GL_SCISSOR_BOX, scissor);
+  glGetIntegerv(GL_CURRENT_PROGRAM, &program);
+  glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &fbo);
+  glGetIntegerv(GL_DEPTH_FUNC, &depth_func);
+  glGetBooleanv(GL_COLOR_WRITEMASK, color_mask);
+  glGetBooleanv(GL_DEPTH_WRITEMASK, &depth_mask);
+  glGetFloatv(GL_DEPTH_RANGE, depth_range);
+
+  char line[400];
+  snprintf(line, sizeof(line),
+           "draw #%d: prim 0x%x, %u idx, samples %u (no depth/scissor/cull: %u), prog %d, fbo %d, "
+           "vp %d,%d %dx%d, scissor %s %d,%d %dx%d, depth %s func 0x%x mask %d range %.3f-%.3f, "
+           "cull %s, blend %s, colormask %d%d%d%d",
+           draw, primitive, num_indices, samples, samples_unrestricted, program, fbo, viewport[0],
+           viewport[1], viewport[2], viewport[3], glIsEnabled(GL_SCISSOR_TEST) ? "on" : "off",
+           scissor[0], scissor[1], scissor[2], scissor[3],
+           glIsEnabled(GL_DEPTH_TEST) ? "on" : "off", depth_func, depth_mask, depth_range[0],
+           depth_range[1], glIsEnabled(GL_CULL_FACE) ? "on" : "off",
+           glIsEnabled(GL_BLEND) ? "on" : "off", color_mask[0], color_mask[1], color_mask[2],
+           color_mask[3]);
+  ps4_boot_trace(line);
+
+  const auto& c = Core::System::GetInstance().GetVertexShaderManager().constants;
+  snprintf(line, sizeof(line),
+           "draw #%d: projection %g %g %g %g / %g %g %g %g / %g %g %g %g / %g %g %g %g, "
+           "pixelcentre %g %g %g %g, viewport %g %g",
+           draw, c.projection[0][0], c.projection[0][1], c.projection[0][2], c.projection[0][3],
+           c.projection[1][0], c.projection[1][1], c.projection[1][2], c.projection[1][3],
+           c.projection[2][0], c.projection[2][1], c.projection[2][2], c.projection[2][3],
+           c.projection[3][0], c.projection[3][1], c.projection[3][2], c.projection[3][3],
+           c.pixelcentercorrection[0], c.pixelcentercorrection[1], c.pixelcentercorrection[2],
+           c.pixelcentercorrection[3], c.viewport[0], c.viewport[1]);
+  ps4_boot_trace(line);
+}
+
+// Port diagnostics: minimal programs drawing the game's own vertices. "plain" maps raw positions
+// to the screen itself; "ubo" uses the projection from Dolphin's vertex uniform block (binding 2).
+// If these pass samples while Dolphin's program doesn't, the problem is in Dolphin's shader.
+static GLuint PS4BuildDebugProgram(bool use_vs_block)
+{
+  static const char* const vs_plain =
+      "#version 300 es\n"
+      "in vec4 rawpos;\n"
+      "void main() { gl_Position = vec4(rawpos.x / 320.0 - 1.0, 1.0 - rawpos.y / 240.0, 0.0, "
+      "1.0); }\n";
+  static const char* const vs_ubo =
+      "#version 300 es\n"
+      "layout(std140) uniform VSBlock { uvec4 c; vec4 m; vec4 pn[6]; vec4 proj[4]; };\n"
+      "in vec4 rawpos;\n"
+      "void main() {\n"
+      "  vec4 p = vec4(rawpos.xy, 0.0, 1.0);\n"
+      "  gl_Position = vec4(dot(proj[0], p), dot(proj[1], p), 0.0, 1.0);\n"
+      "}\n";
+  static const char* const fs =
+      "#version 300 es\n"
+      "precision mediump float;\n"
+      "out vec4 ocol0;\n"
+      "void main() { ocol0 = vec4(1.0, 0.0, 0.0, 1.0); }\n";
+
+  GLuint vs_id = glCreateShader(GL_VERTEX_SHADER);
+  const char* vs_src = use_vs_block ? vs_ubo : vs_plain;
+  glShaderSource(vs_id, 1, &vs_src, nullptr);
+  glCompileShader(vs_id);
+  GLuint fs_id = glCreateShader(GL_FRAGMENT_SHADER);
+  glShaderSource(fs_id, 1, &fs, nullptr);
+  glCompileShader(fs_id);
+  GLuint program = glCreateProgram();
+  glAttachShader(program, vs_id);
+  glAttachShader(program, fs_id);
+  glBindAttribLocation(program, 0, "rawpos");
+  glLinkProgram(program);
+  GLint linked = 0;
+  glGetProgramiv(program, GL_LINK_STATUS, &linked);
+  if (!linked)
+  {
+    char log[256] = {};
+    glGetProgramInfoLog(program, sizeof(log), nullptr, log);
+    char line[320];
+    snprintf(line, sizeof(line), "debug program (%s) failed to link: %s",
+             use_vs_block ? "ubo" : "plain", log);
+    ps4_boot_trace(line);
+    return 0;
+  }
+  if (use_vs_block)
+  {
+    const GLuint block = glGetUniformBlockIndex(program, "VSBlock");
+    if (block != GL_INVALID_INDEX)
+      glUniformBlockBinding(program, block, 2);
+  }
+  return program;
+}
+
+static GLuint PS4QueryDraw(GLuint program, GLenum primitive, u32 num_indices, const void* indices)
+{
+  if (!program)
+    return 12345;
+  GLint previous = 0;
+  glGetIntegerv(GL_CURRENT_PROGRAM, &previous);
+  const GLboolean depth = glIsEnabled(GL_DEPTH_TEST);
+  const GLboolean scissor = glIsEnabled(GL_SCISSOR_TEST);
+  glDisable(GL_DEPTH_TEST);
+  glDisable(GL_SCISSOR_TEST);
+  glUseProgram(program);
+  GLuint query = 0, samples = 0;
+  glGenQueries(1, &query);
+  glBeginQuery(GL_ANY_SAMPLES_PASSED, query);
+  glDrawElements(primitive, num_indices, GL_UNSIGNED_SHORT, indices);
+  glEndQuery(GL_ANY_SAMPLES_PASSED);
+  glGetQueryObjectuiv(query, GL_QUERY_RESULT, &samples);
+  glDeleteQueries(1, &query);
+  glUseProgram(previous);
+  if (depth)
+    glEnable(GL_DEPTH_TEST);
+  if (scissor)
+    glEnable(GL_SCISSOR_TEST);
+  return samples;
+}
+
+// Port diagnostics: Piglet's layout of the vertex uniform block against Dolphin's C++ struct.
+static void PS4LogUniformLayout(GLuint program)
+{
+  const GLuint block = glGetUniformBlockIndex(program, "VSBlock");
+  if (block == GL_INVALID_INDEX)
+  {
+    ps4_boot_trace("uniforms: program has no VSBlock");
+    return;
+  }
+  GLint data_size = 0, binding = 0, count = 0;
+  glGetActiveUniformBlockiv(program, block, GL_UNIFORM_BLOCK_DATA_SIZE, &data_size);
+  glGetActiveUniformBlockiv(program, block, GL_UNIFORM_BLOCK_BINDING, &binding);
+  glGetActiveUniformBlockiv(program, block, GL_UNIFORM_BLOCK_ACTIVE_UNIFORMS, &count);
+  GLint bound_buffer = 0;
+  GLint64 bound_start = 0, bound_size = 0;
+  glGetIntegeri_v(GL_UNIFORM_BUFFER_BINDING, 2, &bound_buffer);
+  glGetInteger64i_v(GL_UNIFORM_BUFFER_START, 2, &bound_start);
+  glGetInteger64i_v(GL_UNIFORM_BUFFER_SIZE, 2, &bound_size);
+
+  char line[400];
+  snprintf(line, sizeof(line),
+           "uniforms: VSBlock size %d (C++ %zu), binding %d, %d active; binding 2 = buffer %d "
+           "+%lld size %lld. C++ offsets: proj %zu lights %zu texmtx %zu trmtx %zu pixelcentre %zu "
+           "viewport %zu pack1 %zu",
+           data_size, sizeof(VertexShaderConstants), binding, count, bound_buffer,
+           static_cast<long long>(bound_start), static_cast<long long>(bound_size),
+           offsetof(VertexShaderConstants, projection), offsetof(VertexShaderConstants, lights),
+           offsetof(VertexShaderConstants, texmatrices),
+           offsetof(VertexShaderConstants, transformmatrices),
+           offsetof(VertexShaderConstants, pixelcentercorrection),
+           offsetof(VertexShaderConstants, viewport), offsetof(VertexShaderConstants, xfmem_pack1));
+  ps4_boot_trace(line);
+
+  if (count <= 0 || count > 128)
+    return;
+  GLint indices[128];
+  glGetActiveUniformBlockiv(program, block, GL_UNIFORM_BLOCK_ACTIVE_UNIFORM_INDICES, indices);
+  GLuint uindices[128];
+  GLint offsets[128];
+  for (int i = 0; i < count; i++)
+    uindices[i] = static_cast<GLuint>(indices[i]);
+  glGetActiveUniformsiv(program, count, uindices, GL_UNIFORM_OFFSET, offsets);
+  int len = snprintf(line, sizeof(line), "uniforms:");
+  for (int i = 0; i < count; i++)
+  {
+    char name[64] = {};
+    GLint array_size = 0;
+    GLenum uniform_type = 0;
+    glGetActiveUniform(program, uindices[i], sizeof(name), nullptr, &array_size, &uniform_type, name);
+    if (len > 300)
+    {
+      ps4_boot_trace(line);
+      len = snprintf(line, sizeof(line), "uniforms:");
+    }
+    len += snprintf(line + len, sizeof(line) - len, " %s=%d", name, offsets[i]);
+  }
+  ps4_boot_trace(line);
+}
+
+// Port diagnostics: what the draw reads its vertices from, as Piglet sees it.
+static void PS4LogVertexInput(int draw, u32 base_index, u32 num_indices)
+{
+  const auto* vm = static_cast<const OGL::VertexManager*>(g_vertex_manager.get());
+  GLint vao = 0, element = 0, array = 0, program = 0;
+  glGetIntegerv(GL_VERTEX_ARRAY_BINDING, &vao);
+  glGetIntegerv(GL_ELEMENT_ARRAY_BUFFER_BINDING, &element);
+  glGetIntegerv(GL_ARRAY_BUFFER_BINDING, &array);
+  glGetIntegerv(GL_CURRENT_PROGRAM, &program);
+
+  char line[400];
+  int len = snprintf(line, sizeof(line),
+                     "draw #%d: vao %d, element buffer %d (stream %u), array buffer %d (stream %u),"
+                     " attribs rawpos %d posmtx %d rawnormal %d rawcolor0 %d rawtex0 %d",
+                     draw, vao, element, vm->GetIndexBufferHandle(), array,
+                     vm->GetVertexBufferHandle(), glGetAttribLocation(program, "rawpos"),
+                     glGetAttribLocation(program, "posmtx"),
+                     glGetAttribLocation(program, "rawnormal"),
+                     glGetAttribLocation(program, "rawcolor0"),
+                     glGetAttribLocation(program, "rawtex0"));
+  ps4_boot_trace(line);
+
+  len = snprintf(line, sizeof(line), "draw #%d: enabled attribs:", draw);
+  for (GLuint i = 0; i < 16 && len < 340; i++)
+  {
+    GLint enabled = 0, size = 0, type = 0, normalized = 0, integer = 0, stride = 0, buffer = 0;
+    glGetVertexAttribiv(i, GL_VERTEX_ATTRIB_ARRAY_ENABLED, &enabled);
+    if (!enabled)
+      continue;
+    glGetVertexAttribiv(i, GL_VERTEX_ATTRIB_ARRAY_SIZE, &size);
+    glGetVertexAttribiv(i, GL_VERTEX_ATTRIB_ARRAY_TYPE, &type);
+    glGetVertexAttribiv(i, GL_VERTEX_ATTRIB_ARRAY_NORMALIZED, &normalized);
+    glGetVertexAttribiv(i, GL_VERTEX_ATTRIB_ARRAY_INTEGER, &integer);
+    glGetVertexAttribiv(i, GL_VERTEX_ATTRIB_ARRAY_STRIDE, &stride);
+    glGetVertexAttribiv(i, GL_VERTEX_ATTRIB_ARRAY_BUFFER_BINDING, &buffer);
+    void* pointer = nullptr;
+    glGetVertexAttribPointerv(i, GL_VERTEX_ATTRIB_ARRAY_POINTER, &pointer);
+    len += snprintf(line + len, sizeof(line) - len, " [%u: %dx0x%x%s%s stride %d +%zu buf %d]",
+                    i, size, type, normalized ? " norm" : "", integer ? " int" : "", stride,
+                    reinterpret_cast<size_t>(pointer), buffer);
+  }
+  ps4_boot_trace(line);
+
+  // What the GPU-side buffers actually hold.
+  if (element)
+  {
+    const u32 count = std::min(num_indices, 6u);
+    const auto* indices = static_cast<const u16*>(glMapBufferRange(
+        GL_ELEMENT_ARRAY_BUFFER, base_index * sizeof(u16), count * sizeof(u16), GL_MAP_READ_BIT));
+    len = snprintf(line, sizeof(line), "draw #%d: indices from %u:", draw, base_index);
+    for (u32 i = 0; indices && i < count; i++)
+      len += snprintf(line + len, sizeof(line) - len, " %u", indices[i]);
+    if (indices)
+      glUnmapBuffer(GL_ELEMENT_ARRAY_BUFFER);
+    else
+      len += snprintf(line + len, sizeof(line) - len, " (map failed, GL error 0x%x)", glGetError());
+    ps4_boot_trace(line);
+  }
+  if (array)
+  {
+    const auto* words = static_cast<const u32*>(
+        glMapBufferRange(GL_ARRAY_BUFFER, 0, 12 * sizeof(u32), GL_MAP_READ_BIT));
+    len = snprintf(line, sizeof(line), "draw #%d: vertex bytes:", draw);
+    for (u32 i = 0; words && i < 12; i++)
+    {
+      float f;
+      std::memcpy(&f, &words[i], sizeof(f));
+      len += snprintf(line + len, sizeof(line) - len, " %08x(%g)", words[i], f);
+    }
+    if (words)
+      glUnmapBuffer(GL_ARRAY_BUFFER);
+    else
+      len += snprintf(line + len, sizeof(line) - len, " (map failed, GL error 0x%x)", glGetError());
+    ps4_boot_trace(line);
+  }
+}
+#endif
